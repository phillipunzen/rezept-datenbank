# Öffentliche Adresse der App (für Links, QR-Codes und die Authentik-Weiterleitung)
APP_URL=https://rezepte.example.org
# Zufälliger, geheimer Wert (mind. 32 Zeichen), z. B.: openssl rand -hex 32
# Wird auch zum Verschlüsseln gespeicherter Zugangsdaten (Claude, Home Assistant) verwendet – nicht nachträglich ändern.
APP_SECRET=
HOST_PORT=3000

# Externe MariaDB (Datenbank und Benutzer vorher anlegen)
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=rezeptbuch
DB_USER=rezeptbuch
DB_PASSWORD=

# Optional: Administrator beim ersten Start anlegen (sonst wird das erste registrierte Konto Admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: Anmeldung über Authentik (OpenID Connect)
# Redirect-URI im Authentik-Provider: ${APP_URL}/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=Authentik
# Mitglieder dieser Authentik-Gruppe werden automatisch Administratoren (Scope "groups" nötig)
OIDC_ADMIN_GROUP=
OIDC_SCOPES=openid email profile

# Cookies nur über HTTPS (Standard: automatisch, wenn APP_URL mit https beginnt)
# COOKIE_SECURE=true
# Website-Import auch von Adressen im lokalen Netz erlauben
# ALLOW_PRIVATE_FETCH=false
