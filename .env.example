# Standard: externe MariaDB, dedizierte Datenbank und Benutzer vorher anlegen.
# Sonderzeichen in Benutzer/Passwort URL-encodieren. Kein DB-Server in der App.
DATABASE_URL=mysql://rezeptdatenbank:CHANGE_ME@db.example.internal:3306/rezeptdatenbank
APP_ORIGIN=http://localhost:8080
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
# openssl rand -hex 32; nach Einrichtung kein erneuter Bootstrap möglich.
INITIAL_SETUP_TOKEN=CHANGE_ME_TO_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=false
TRUST_PROXY=false
REGISTRATION_ENABLED=false
LOG_LEVEL=info
# Optional: docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d
# Dafür DATABASE_URL=mysql://rezeptdatenbank:PASSWORT@mariadb:3306/rezeptdatenbank
MARIADB_DATABASE=rezeptdatenbank
MARIADB_USER=rezeptdatenbank
MARIADB_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME

# Optional: Passwortreset per SMTP. Ohne SMTP_HOST deaktiviert.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional: OIDC (Authentik, Keycloak, Entra ID), HTTPS-Issuer.
# Callback beim Provider: APP_ORIGIN/api/v1/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REGISTRATION_ENABLED=false
OIDC_LABEL=Single Sign-On

# Hinter dem Reverseproxy: APP_ORIGIN=https://rezepte.example.de
# COOKIE_SECURE=true, TRUST_PROXY=true. Proxy leitet Host und X-Forwarded-* weiter.
# IP + Port: APP_ORIGIN=http://192.168.10.70:8080, COOKIE_SECURE=false.
# Browser-Offline-Funktionen erfordern unabhängig davon HTTPS.
# Optionale experimentelle Cookidoo-Einkaufslistenverbindung (inoffizielle API).
COOKIDOO_ENABLED=true
# Nur Entwicklung: Zugangsdaten über HTTP zulassen; bei HTTPS false lassen.
COOKIDOO_ALLOW_HTTP=false
# Optional 64 Hexzeichen (openssl rand -hex 32). Ohne Wert: Schlüsseldatei im Upload-Volume.
# Mit externer Datenbank auch diesen Schlüssel bzw. das gesamte Upload-Volume sichern.
COOKIDOO_ENCRYPTION_KEY=

# Öffentliche Rezeptsuche unter /entdecken. Jedes Rezept muss ausdrücklich freigegeben werden.
PUBLIC_CATALOG_ENABLED=true
