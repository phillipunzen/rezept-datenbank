# Ausschließlich für einen separaten Entwicklungs-/Test-Checkout.
# cp .env.development.example .env; Passwörter und Einrichtungscode ersetzen.
# Start explizit mit beiden Compose-Dateien; dabei läuft eine eigene Test-MariaDB.
DATABASE_URL=mysql://rezeptdatenbank:CHANGE_ME@mariadb:3306/rezeptdatenbank
APP_ORIGIN=http://localhost:8080
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
INITIAL_SETUP_TOKEN=CHANGE_ME_TO_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=false
TRUST_PROXY=false
REGISTRATION_ENABLED=false
PUBLIC_CATALOG_ENABLED=true
COOKIDOO_ENABLED=false
COOKIDOO_ALLOW_HTTP=false
LOG_LEVEL=info
MARIADB_DATABASE=rezeptdatenbank
MARIADB_USER=rezeptdatenbank
MARIADB_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME_TO_A_DIFFERENT_ROOT_PASSWORD
